# ---------- Embedding model (runs locally via Hugging Face, NOT Ollama) ----------
EMBED_MODEL=openai/clip-vit-base-patch32
# Better alternatives (same code path if using CLIPModel):
# EMBED_MODEL=openai/clip-vit-large-patch14
# EMBED_MODEL=laion/CLIP-ViT-B-32-laion2B-s34B-b79K
EMBED_DEVICE=auto            # auto | cpu | cuda | mps
EMBED_BATCH_SIZE=32

# ---------- Vector DB ----------
CHROMA_DIR=./storage/chroma
CHROMA_COLLECTION=mm_rag

# ---------- Retrieval ----------
TOP_K_IMAGES=4
TOP_K_TEXTS=4
FUSION_ALPHA=0.5             # weight of image embedding when query = image + text (0..1)
TEXT_CHUNK_TOKENS=60         # must stay < 77 (CLIP text limit)
TEXT_CHUNK_OVERLAP=10

# ---------- Generation (Ollama) ----------
# Cloud:  OLLAMA_HOST=https://ollama.com  + OLLAMA_API_KEY
# Local:  OLLAMA_HOST=http://localhost:11434 (API key not needed)
OLLAMA_HOST=https://ollama.com/v1
OLLAMA_API_KEY=
# Must be a VISION-capable model. Verify the exact name available to your account:
#   cloud models list: https://ollama.com/search?c=cloud   |  local: `ollama list`
OLLAMA_MODEL=llama3.2-vision:latest
OLLAMA_TEMPERATURE=0.2

# ---------- Data ----------
DATA_DIR=./data
IMAGES_PER_BREED=40
HF_DATASET=timm/oxford-iiit-pet
